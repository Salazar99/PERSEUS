# ===== Settings =====
OT ?= $(PWD)/external/opentitan
USE_LOCAL_UART := 1

# ===== Stubs (compiled first) =====
STUBS = \
	rtl/top_pkg_stub.sv \
	rtl/top_racl_pkg_stub.sv

# ===== Dirs =====
PRIM_DIR     := $(OT)/hw/ip/prim/rtl
TLUL_DIR     := $(OT)/hw/ip/tlul/rtl
EDN_DIR      := $(OT)/hw/ip/edn/rtl
CSRNG_DIR    := $(OT)/hw/ip/csrng/rtl
ENTROPY_DIR  := $(OT)/hw/ip/entropy_src/rtl

PKG_DIRS := $(PRIM_DIR) $(TLUL_DIR) $(EDN_DIR) $(CSRNG_DIR) $(ENTROPY_DIR)
SV_DIRS  := $(PRIM_DIR) $(TLUL_DIR)

# ===== Discover all packages (*.sv ending with _pkg.sv) =====
define FIRST_EXISTING
$(firstword $(foreach D,$(PKG_DIRS),$(wildcard $(D)/$1)))
endef


ENTROPY_PKG      := $(call FIRST_EXISTING,entropy_src_pkg.sv)
ENTROPY_REG_PKG  := $(call FIRST_EXISTING,entropy_src_reg_pkg.sv)
CSRNG_PKG        := $(call FIRST_EXISTING,csrng_pkg.sv)
CSRNG_REG_PKG    := $(call FIRST_EXISTING,csrng_reg_pkg.sv)
EDN_PKG          := $(call FIRST_EXISTING,edn_pkg.sv)
EDN_REG_PKG      := $(call FIRST_EXISTING,edn_reg_pkg.sv)
TLUL_PKG         := $(call FIRST_EXISTING,tlul_pkg.sv)


# All packages present in the trees
PKG_ALL := $(sort $(foreach D,$(PKG_DIRS),$(wildcard $(D)/*_pkg.sv)))

# --- PRIM "core" packages that many others depend on (compile these first) ---
PRIM_CORE_PKGS := \
	$(PRIM_DIR)/prim_pkg.sv \
	$(PRIM_DIR)/prim_util_pkg.sv \
	$(PRIM_DIR)/prim_mubi_pkg.sv \
	$(PRIM_DIR)/prim_subreg_pkg.sv \
	$(PRIM_DIR)/prim_alert_pkg.sv \
	$(PRIM_DIR)/prim_secded_pkg.sv



# Priority: PRIM core -> ENTROPY -> CSRNG -> EDN -> TLUL

PKG_PRIORITY := \
	$(PRIM_CORE_PKGS) \
	$(ENTROPY_REG_PKG) $(ENTROPY_PKG) \
	$(CSRNG_REG_PKG)   $(CSRNG_PKG) \
	$(EDN_REG_PKG)     $(EDN_PKG) \
	$(TLUL_PKG)

# Remove empties and duplicates, then append remaining packages in a stable order
PKG_PRIORITY := $(strip $(filter-out ,$(PKG_PRIORITY)))
PKG_ORDERED  := $(strip $(PKG_PRIORITY) \
	  $(filter-out $(PKG_PRIORITY),$(PKG_ALL)))


# ===== Non-package SV files from PRIM/TLUL (all *.sv minus *_pkg.sv) =====
SV_ALL     := $(sort $(foreach D,$(SV_DIRS),$(wildcard $(D)/*.sv)))
SV_OTHERS  := $(filter-out $(PKG_ALL),$(SV_ALL))

# ===== UART RTL (local by default) =====
LOCAL_UART = \
	rtl/uart_reg_pkg.sv \
	rtl/uart_reg_top.sv \
	rtl/uart_tx.sv \
	rtl/uart_rx.sv \
	rtl/uart_core.sv \
	rtl/uart.sv

OT_UART_DIR := $(OT)/hw/ip/uart/rtl
RTL_UART    := $(if $(filter 1,$(USE_LOCAL_UART)),$(LOCAL_UART),$(OT_UART_DIR)/*.sv)

# ===== Testbench =====
TB_LIST = \
	rtl/top_uart_tb.sv \
	rtl/tlul_host.sv

CPP = sim/sim_main.cpp

# ===== Verilator flags =====
VERILATOR_FLAGS = -Wall -Wno-UNOPTFLAT -Wno-WIDTHEXPAND -Wno-INITIALDLY \
	-sv --trace --timing

# ===== Targets =====
all: build run

prepare:
	@mkdir -p external || true
	@if [ ! -d "$(OT)/.git" ]; then \
	echo "Clone OpenTitan (for TLUL/PRIM) into external/opentitan:"; \
	echo "  git clone https://github.com/lowRISC/opentitan.git $(OT)"; \
	exit 1; \
	fi

# ORDER: stubs -> ALL packages (priority first) -> PRIM/TLUL others -> UART -> TB/CPP
build: prepare
	@echo "==> Packages (priority first):"
	@echo "  ENTROPY_PKG = $(ENTROPY_PKG)"
	@echo "  CSRNG_PKG   = $(CSRNG_PKG)"
	@echo "  EDN_PKG     = $(EDN_PKG)"
	@echo "  TLUL_PKG    = $(TLUL_PKG)"
	@echo "==> Total package count = $(words $(PKG_ORDERED))"
	verilator $(VERILATOR_FLAGS) --cc --exe --build \
	-I$(PRIM_DIR) -I$(TLUL_DIR) -I$(EDN_DIR) -I$(CSRNG_DIR) -I$(ENTROPY_DIR) \
	$(STUBS) \
	$(PKG_ORDERED) \
	$(SV_OTHERS) \
	$(RTL_UART) \
	$(TB_LIST) $(CPP) \
	--top-module top_uart_tb \
	-o Vtop_uart_tb

run:
	./obj_dir/Vtop_uart_tb

clean:
	rm -rf obj_dir *.vcd *.fst

.PHONY: all prepare build run clean