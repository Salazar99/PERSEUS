      $var wire 1 Q# parity_enable $end
      $var wire 1 {$ wr $end
      $var wire 1 U$ wr_parity $end
      $var wire 8 z$ wr_data [7:0] $end
      $var wire 1 !$ idle $end
      $var wire 1 "$ tx $end
      $var wire 4 I$ baud_div_q [3:0] $end
      $var wire 1 J$ tick_baud_q $end
      $var wire 4 K$ bit_cnt_q [3:0] $end
      $var wire 4 9% bit_cnt_d [3:0] $end
      $var wire 11 L$ sreg_q [10:0] $end
      $var wire 11 :% sreg_d [10:0] $end
      $var wire 1 "$ tx_q $end
      $var wire 1 ;% tx_d $end
     $upscope $end
    $upscope $end
   $upscope $end
   $scope module u_tl_intg $end
    $var wire 1 p% EnableDataIntgGen $end
    $var wire 107 < tl_i [106:0] $end
    $var wire 107 @ tl_o [106:0] $end
    $var wire 43 y cmd [42:0] $end
    $var wire 57 { unused_cmd_payload [56:0] $end
    $var wire 7 } cmd_intg [6:0] $end
    $var wire 32 ~ data_final [31:0] $end
    $var wire 7 !! data_intg [6:0] $end
    $var wire 1 "! unused_tl $end
    $scope module gen_data_intg $end
     $var wire 32 #! unused_data [31:0] $end
     $scope module u_data_gen $end
      $var wire 32 ~ data_i [31:0] $end
      $var wire 39 $! data_o [38:0] $end
     $upscope $end
    $upscope $end
    $scope module u_cmd_gen $end
     $var wire 57 &! data_i [56:0] $end
     $var wire 64 (! data_o [63:0] $end
    $upscope $end
   $upscope $end
  $upscope $end
 $upscope $end
$enddefinitions $end


